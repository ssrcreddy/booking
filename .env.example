# Copy to .env.local and fill in from the Neon Console.
# Auth URL: project > Auth > Configuration
VITE_NEON_AUTH_URL=https://ep-xxx.neonauth.us-east-2.aws.neon.tech/neondb/auth
# Data API URL: project > Data API
VITE_NEON_DATA_API_URL=https://ep-xxx.apirest.us-east-2.aws.neon.tech/neondb/rest/v1

# Booking assistant (server-side only; no VITE_ prefix so it never reaches the browser).
# Only the key for BOOKING_ASSISTANT_PROVIDER in src/config.ts is needed.
# claude: https://platform.claude.com > API keys
ANTHROPIC_API_KEY=
# openai: https://platform.openai.com > API keys (OPENAI_MODEL optional, default gpt-5.5)
OPENAI_API_KEY=
OPENAI_MODEL=
# gemini: https://aistudio.google.com > API keys (GEMINI_MODEL optional, default gemini-flash-latest)
GEMINI_API_KEY=
GEMINI_MODEL=
